#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    // The hold-tap behaviors the keymap may use:
    // - mt_  holds a modifier, taps a key
    // - lt_  holds a layer, taps a key
    // - omt_ holds a modifier, one-shots it on tap
    // - olt_ holds a layer, one-shots it on tap
    // mt_ and lt_ come in the flavors the keymap can pick between: tp
    // (tap-preferred, the default, used on the home-row) and hp
    // (hold-preferred, used on the thumb keys). One-shot keys are always
    // tap-preferred, so that a quick tap always one-shots. ih is the
    // instant-hold behavior below, used where the hold key must be down
    // before anything else (F18 and F19).
    //
    // hold-preferred takes the hold as soon as any other key goes down, which
    // is what makes a thumb layer engage without waiting, and also what made it
    // engage mid-word on a thumb key pressed inside a burst of typing. The hp
    // pair therefore refuses to hold at all within require-prior-idle-ms of the
    // last key press, so a thumb key only shifts a layer once typing has
    // actually paused, and quick-tap-ms keeps a repeated tap a tap.
    behaviors {
        mt_tp: mod_tap_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
        mt_hp: mod_tap_hold_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        lt_tp: layer_tap_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
        lt_hp: layer_tap_hold_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        omt_: oneshot_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&sk>;
        };
        olt_: oneshot_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&sl>;
        };

        // Instant hold. The hold key goes down on press, before any
        // decision, so a following key or a mouse click sees it with no
        // delay. A release inside tapping-term-ms (the same 200ms as
        // QMK's TAPPING_TERM) releases the hold and then taps the key.
        // Holding longer leaves the hold down until release. Other keys
        // are not queued: this is not a stock hold-tap, which would hold
        // the next key back until it decided.
        ih: instant_hold {
            compatible = "zmk,behavior-instant-hold";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
            compatible = "zmk,keymap";

            default_layer {
                    display-name = "Base";
                    bindings = <
#LAYER_0#
                    >;
            };

            raise_layer {
                    display-name = "Nav/Num";
                    bindings = <
#LAYER_1#
                    >;
            };

            lower_layer {
                    display-name = "Symbols";
                    bindings = <
#LAYER_2#
                    >;
            };

            adjust_layer {
                    display-name = "Adj";
                    bindings = <
#LAYER_3#
                    >;
            };

            mouse_layer {
                    display-name = "Mou";
                    bindings = <
#LAYER_4#
                    >;
            };
        };
#COMBOS#
};
