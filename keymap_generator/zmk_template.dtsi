#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    // mt_/lt_ hold a modifier/layer and tap a key; omt_/olt_ one-shot on tap.
    // Flavor suffix: tp (home-row) or hp (thumbs). One-shots are always tp.
    //
    // hp takes the hold as soon as another key goes down. require-prior-idle-ms
    // stops that mid-word; quick-tap-ms keeps a repeated tap a tap.
    behaviors {
        mt_tp: mod_tap_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
        mt_hp: mod_tap_hold_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        lt_tp: layer_tap_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
        lt_hp: layer_tap_hold_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        omt_: oneshot_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&sk>;
        };
        olt_: oneshot_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&sl>;
        };
    };

    keymap {
            compatible = "zmk,keymap";

            default_layer {
                    display-name = "Base";
                    bindings = <
#LAYER_0#
                    >;
            };

            raise_layer {
                    display-name = "Nav/Num";
                    bindings = <
#LAYER_1#
                    >;
            };

            lower_layer {
                    display-name = "Symbols";
                    bindings = <
#LAYER_2#
                    >;
            };

            hyper_layer {
                    display-name = "Hyper";
                    bindings = <
#LAYER_3#
                    >;
            };

            adjust_layer {
                    display-name = "Adj";
                    bindings = <
#LAYER_4#
                    >;
            };

            mouse_layer {
                    display-name = "Mou";
                    bindings = <
#LAYER_5#
                    >;
            };
        };
#COMBOS#
};
